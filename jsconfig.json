{
  "compilerOptions": {
    "checkJs": true,
    "jsx": "react-native",
    "noImplicitAny": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@screens/*": [
        "./src/screens/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@theme/*": [
        "./src/utils/theme/*"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ]
}